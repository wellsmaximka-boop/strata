            },
            "GearConfig": {
                "$path": "src/shared/GearConfig.lua"
            },
            "OreModelBuilder": {
                "$path": "src/shared/OreModelBuilder.lua"
            },
            "UIKit": {
                "$path": "src/shared/UIKit.lua"
            },
            "DigSite": {
                "$path": "src/shared/DigSite.lua"
            },
            "Caverns": {
                "$path": "src/shared/Caverns.lua"
            },
            "ItemModels": {
                "$path": "src/shared/ItemModels.lua"
            }
        },
        "Workspace": {
